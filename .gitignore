# Godot 4+ editor cache/import output — regenerated locally, never authored by hand.
.godot/
game/.godot/

# Godot export artifacts
export.cfg
export_credentials.cfg
*.translation

# Node (in case the lpc/ generator's deps ever get installed locally)
node_modules/

# Local Claude Code session state — pero las skills del proyecto SÍ se versionan,
# son parte de la herramienta de trabajo (sprite-pipeline y sus scripts).
.claude/*
!.claude/skills/

# Arte crudo / packs comprados. NO va al repo: es público y redistribuir un pack
# comprado no corresponde. Se sincroniza aparte (ver README). Nada del proyecto
# lo referencia: es staging para generar los assets de game/assets/world/.
game/assets/_incoming/

# OS cruft
Thumbs.db
.DS_Store

# Editor/session scratch
*.tmp
*.log
*.stale_backup_*
__pycache__/
